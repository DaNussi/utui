{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Nix Build",
            "type": "shell",
            "command": "nix build --print-build-logs",
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": true
            }
        },
        {
            "label": "Nix Run",
            "type": "shell",
            "command": "nix run --print-build-logs",
            "runOptions": {
                "instancePolicy": "terminateOldest",
                "instanceLimit": 1
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": true
            }
        }
    ]
}